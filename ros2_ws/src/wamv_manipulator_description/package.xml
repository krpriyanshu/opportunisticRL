<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wamv_manipulator_description</name>
  <version>0.0.1</version>
  <description>
    Combines VRX's WAM-V description with a mounted manipulator (Franka
    Emika Panda, via moveit_resources_panda_description) via a single
    fixed mounting joint. Milestone M1 of the opportunity-aware RL
    marine grasping project -- see docs/project-plan.md.
  </description>
  <maintainer email="noreply@example.com">opportunity_rl contributors</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>wamv_gazebo</exec_depend>
  <exec_depend>moveit_resources_panda_description</exec_depend>
  <exec_depend>moveit_resources_panda_moveit_config</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
